{
  "name": "@better-compute-examples/postgres",
  "version": "0.0.0",
  "private": true,
  "description": "better-compute on PostgreSQL with separate api, worker and gateway processes.",
  "type": "module",
  "scripts": {
    "db": "docker compose up -d --wait",
    "migrate": "better-compute migrate",
    "api": "better-compute serve --roles api --no-migrate",
    "worker": "better-compute serve --roles controllers,scheduler,sinks,iam --no-migrate",
    "gateway": "better-compute serve --roles gateway --no-migrate",
    "doctor": "better-compute doctor"
  },
  "dependencies": {
    "@better-compute-examples/shared": "workspace:*",
    "@better-compute/cli": "workspace:*",
    "@better-compute/server": "workspace:*"
  }
}

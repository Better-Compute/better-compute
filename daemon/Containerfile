# bcd as a container image, for running it as a Kubernetes DaemonSet (deploy/kubernetes). On a
# machine bcd owns, install the binary and bcd.service instead (the install script).
#
#   docker build -f daemon/Containerfile -t bcd:dev --build-arg VERSION=0.0.0-dev daemon
#
# The host build without cgo: GPUs are read through nvidia-smi, which the NVIDIA container runtime
# mounts into the pod (NVIDIA_VISIBLE_DEVICES=all, NVIDIA_DRIVER_CAPABILITIES=utility).
#
# kubectl: as the DaemonSet, bcd keeps its Node's bcd.dev/* labels, reaps pods still on released
# devices and publishes its DRA ResourceSlice through kubectl, with the pod's service account
# (in-cluster config). The version is fixed and each architecture's binary is checked against the
# sha256 below (dl.k8s.io's published sums for v1.34.1); a mismatch fails the build.

FROM golang:1.26-bookworm AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
ARG VERSION=0.0.0-dev
ARG RELEASE_SEQUENCE=0
ARG TARGETARCH=amd64
RUN case "${TARGETARCH}" in \
      amd64) sum=7721f265e18709862655affba5343e85e1980639395d5754473dafaadcaa69e3 ;; \
      arm64) sum=420e6110e3ba7ee5a3927b5af868d18df17aae36b720529ffa4e9e945aa95450 ;; \
      *) echo "no pinned kubectl for ${TARGETARCH}" >&2; exit 1 ;; \
    esac \
 && mkdir -p /out \
 && curl -fsSLo /out/kubectl "https://dl.k8s.io/release/v1.34.1/bin/linux/${TARGETARCH}/kubectl" \
 && echo "${sum}  /out/kubectl" | sha256sum -c - \
 && chmod 0755 /out/kubectl
RUN CGO_ENABLED=0 go build -trimpath -tags nonvml \
      -ldflags "-s -w -X main.version=${VERSION} -X main.releaseSequence=${RELEASE_SEQUENCE}" \
      -o /out/bcd ./cmd/bcd

FROM debian:bookworm-slim
# nftables (instance network policy), kmod (modprobe), pciutils and util-linux (inventory, wipes).
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates nftables kmod pciutils util-linux \
 && rm -rf /var/lib/apt/lists/*
COPY --from=build /out/bcd /usr/local/bin/bcd
COPY --from=build /out/kubectl /usr/local/bin/kubectl
ENTRYPOINT ["/usr/local/bin/bcd"]

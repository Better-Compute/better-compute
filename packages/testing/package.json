  },
  "peerDependenciesMeta": {
    "@better-iam/core": {
      "optional": true
    },
    "@better-iam/server": {
      "optional": true
    },
    "@better-iam/adapter-sqlite": {
      "optional": true
    },
    "@electric-sql/pglite": {
      "optional": true
    }
  }

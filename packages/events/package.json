{
  "name": "@better-compute/events",
  "version": "0.1.0",
  "description": "Event delivery for better-compute: per-tenant signed webhooks with retries and dead letters, and the SSE /watch stream, read from the outbox.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "better-compute contributors",
  "homepage": "https://github.com/better-compute/better-compute/tree/main/packages/events#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/better-compute/better-compute.git",
    "directory": "packages/events"
  },
  "bugs": {
    "url": "https://github.com/better-compute/better-compute/issues"
  },
  "keywords": [
    "better-compute",
    "events",
    "webhooks",
    "signed-webhooks",
    "sse",
    "server-sent-events",
    "outbox",
    "dead-letter-queue"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@better-compute/core": "workspace:*"
  }
}

{
  "name": "@better-compute/iam",
  "version": "0.1.0",
  "description": "The better-iam bridge for better-compute: IAM plugin and catalog, event inbox, authz projection and resolver, the embedded IamPort, usage sink and flag cache.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "better-compute contributors",
  "homepage": "https://github.com/better-compute/better-compute/tree/main/packages/iam#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/better-compute/better-compute.git",
    "directory": "packages/iam"
  },
  "bugs": {
    "url": "https://github.com/better-compute/better-compute/issues"
  },
  "keywords": [
    "better-compute",
    "better-iam",
    "iam",
    "authorization",
    "authz",
    "policy",
    "multi-tenant",
    "usage-metering"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@better-compute/core": "workspace:*"
  },
  "peerDependencies": {
    "@better-iam/adapter-sqlite": "^0.2.0",
    "@better-iam/client": "^0.2.0",
    "@better-iam/core": "^0.2.0",
    "@better-iam/server": "^0.2.0"
  },
  "peerDependenciesMeta": {
    "@better-iam/adapter-sqlite": {
      "optional": true
    },
    "@better-iam/client": {
      "optional": true
    },
    "@better-iam/server": {
      "optional": true
    }
  },
  "devDependencies": {
    "@better-iam/adapter-sqlite": "^0.2.0",
    "@better-iam/client": "^0.2.0",
    "@better-iam/core": "^0.2.0",
    "@better-iam/server": "^0.2.0"
  }
}

{
  "name": "@better-compute/server",
  "version": "0.2.0",
  "description": "The better-compute control plane: betterCompute(), the operation envelope, router and runtimes.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "better-compute contributors",
  "homepage": "https://github.com/better-compute/better-compute/tree/main/packages/server#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/better-compute/better-compute.git",
    "directory": "packages/server"
  },
  "bugs": {
    "url": "https://github.com/better-compute/better-compute/issues"
  },
  "keywords": [

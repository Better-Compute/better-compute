    "@better-iam/adapter-sqlite": {
      "optional": true
    },
    "@better-iam/cli": {
      "optional": true
    },
    "@better-iam/client": {
      "optional": true
    },
    "@better-iam/core": {
      "optional": true
    },
    "@better-iam/mcp": {
      "optional": true
    },
    "@better-iam/server": {
      "optional": true
    },
    "@electric-sql/pglite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@better-iam/adapter-sqlite": "^0.3.0",
    "@better-iam/cli": "^0.3.0",
    "@better-iam/client": "^0.3.0",
    "@better-iam/core": "^0.3.0",
    "@better-iam/mcp": "^0.3.0",
    "@better-iam/server": "^0.3.0"
  }
}

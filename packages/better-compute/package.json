    "@better-compute/events": "workspace:*",
    "@better-compute/fleet": "workspace:*",
    "@better-compute/gateway": "workspace:*",
    "@better-compute/iam": "workspace:*",
    "@better-compute/inventory": "workspace:*",
    "@better-compute/mcp": "workspace:*",
    "@better-compute/metal": "workspace:*",
    "@better-compute/observability": "workspace:*",
    "@better-compute/pki": "workspace:*",
    "@better-compute/postgres": "workspace:*",
    "@better-compute/protocol": "workspace:*",
    "@better-compute/provision": "workspace:*",
    "@better-compute/rollout": "workspace:*",
    "@better-compute/server": "workspace:*",
    "@better-compute/testing": "workspace:*",
    "@better-compute/vps": "workspace:*"
  },
  "peerDependencies": {
    "@better-iam/adapter-sqlite": ">=0.2.0 <0.4.0",
    "@better-iam/cli": ">=0.2.0 <0.4.0",

{
  "name": "better-compute",
  "version": "0.3.0",
  "description": "Manage GPU and bare-metal capacity and provision nodes in many ways: one package with every better-compute subpath.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "better-compute contributors",
  "homepage": "https://github.com/better-compute/better-compute/tree/main/packages/better-compute#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/better-compute/better-compute.git",
    "directory": "packages/better-compute"
  },
  "bugs": {
    "url": "https://github.com/better-compute/better-compute/issues"
  },
  "keywords": [
    "gpu",
    "cpu",
    "sandbox",
    "control-plane",
    "typescript",
    "scheduler",
    "bare-metal",
    "vps",
    "reservations",
    "better-iam"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "better-compute": "./dist/cli-bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {

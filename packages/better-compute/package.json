      "types": "./dist/events.d.ts",
      "import": "./dist/events.js"
    },
    "./fleet": {
      "types": "./dist/fleet.d.ts",
      "import": "./dist/fleet.js"
    },
    "./rollout": {
      "types": "./dist/rollout.d.ts",
      "import": "./dist/rollout.js"
    },
    "./audit": {
      "types": "./dist/audit.d.ts",
      "import": "./dist/audit.js"
    },
    "./observability": {
      "types": "./dist/observability.d.ts",
      "import": "./dist/observability.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./gateway": {
      "types": "./dist/gateway.d.ts",
      "import": "./dist/gateway.js"
    },
    "./pki": {
      "types": "./dist/pki.d.ts",
      "import": "./dist/pki.js"

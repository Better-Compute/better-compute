      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js"
    },
    "./inventory": {
      "types": "./dist/inventory.d.ts",
      "import": "./dist/inventory.js"
    },
    "./capacity": {
      "types": "./dist/capacity.d.ts",
      "import": "./dist/capacity.js"
    },
    "./provision": {
      "types": "./dist/provision.d.ts",
      "import": "./dist/provision.js"
    },
    "./metal": {
      "types": "./dist/metal.d.ts",
      "import": "./dist/metal.js"
    },
    "./vps": {
      "types": "./dist/vps.d.ts",
      "import": "./dist/vps.js"
    },
    "./iam": {
      "types": "./dist/iam.d.ts",
      "import": "./dist/iam.js"
    },

{
  "name": "@better-compute/rollout",
  "version": "0.1.0",
  "description": "Signed bcd releases and wave rollouts (A/B self-update) for better-compute, within each pool's disruption budget.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "better-compute contributors",
  "homepage": "https://github.com/better-compute/better-compute/tree/main/packages/rollout#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/better-compute/better-compute.git",
    "directory": "packages/rollout"
  },
  "bugs": {
    "url": "https://github.com/better-compute/better-compute/issues"
  },
  "keywords": [
    "gpu",
    "bare-metal",
    "fleet",
    "rollout",
    "self-update",
    "supply-chain"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
